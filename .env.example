# ==============================================================================
# ROBO CRACKERS — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in all values before running the application.
# NEVER commit your actual .env file with real secrets to version control.
# ==============================================================================

# ─── DATABASE (Required) ───────────────────────────────────────────────────────
# PostgreSQL connection string. Use Neon (https://neon.tech), Supabase, or
# any hosted PostgreSQL provider. Local format shown below.
# IMPORTANT: The @db.Decimal(10,2) Prisma types require PostgreSQL (not SQLite/MySQL)
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/robocrackers?schema=public"

# Test database (used in integration tests). Keep separate from production.
TEST_DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/robocrackers_test?schema=public"

# ─── AUTH.JS / NEXTAUTH (Required) ────────────────────────────────────────────
# URL of your deployed application. Must match the actual domain in production.
NEXTAUTH_URL="https://your-production-domain.com"

# Must be a cryptographically secure random string of at least 32 characters.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE-THIS-TO-A-SECURE-RANDOM-STRING-MINIMUM-32-CHARACTERS"

# ─── ADMIN SEED CREDENTIALS (Required for first run) ──────────────────────────
# Used only during `npm run db:seed` to create the initial super admin account.
# Change the password immediately after first login.
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_INITIAL_PASSWORD="CHANGE-THIS-ON-FIRST-LOGIN"

# ─── UPSTASH REDIS (Strongly Recommended for Production) ──────────────────────
# Required for distributed rate limiting on enquiry/login endpoints.
# Without this, the system uses an in-memory fallback (not suitable for production).
# Sign up free at: https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── PUBLIC BUSINESS CONTACT DETAILS ──────────────────────────────────────────
# These are exposed to the browser (NEXT_PUBLIC_ prefix).
# WhatsApp number format: country code + number without + or spaces (e.g. 919342764302)
NEXT_PUBLIC_WHATSAPP_NUMBER="919342764302"
NEXT_PUBLIC_PHONE_NUMBER="+91 96296 59379"
NEXT_PUBLIC_SITE_URL="https://your-production-domain.com"

# ─── OPTIONAL: ANALYTICS / TRACKING ───────────────────────────────────────────
# Only set these if you have the relevant accounts configured.
# Leave blank to disable analytics in development.
# NEXT_PUBLIC_GTM_ID=""            # Google Tag Manager ID (e.g. GTM-XXXXXXX)
# NEXT_PUBLIC_GA4_ID=""            # Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# NEXT_PUBLIC_META_PIXEL_ID=""     # Meta Pixel ID for Facebook/Instagram Ads

# ─── OPTIONAL: FILE UPLOADS ────────────────────────────────────────────────────
# If deploying to Vercel or serverless environments, local disk storage is
# NOT persistent. Configure a cloud storage provider for production uploads.
# CLOUDFLARE_R2_ENDPOINT=""        # or AWS S3, Supabase Storage, etc.
# CLOUDFLARE_R2_ACCESS_KEY_ID=""
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
# CLOUDFLARE_R2_BUCKET_NAME=""
# CLOUDFLARE_R2_PUBLIC_URL=""      # Public CDN URL for uploaded files

# ─── DEPLOYMENT NOTES ──────────────────────────────────────────────────────────
# Vercel: Add all variables above to the Vercel project settings dashboard.
# Railway/Render: Add to the environment variables section.
# Self-hosted: Copy .env.example to .env and fill in values on the server.
#
# DO NOT set NODE_ENV manually — Next.js sets it automatically based on `next build`.
